 od in od_final:\n","    district    = od['district']\n","    origin      = od['origin']\n","    destination = od['destination']\n","    buffer_r    = od['buffer_r_km']\n","\n","    # buffer 후보 추출\n","    district_df = hotspots[hotspots['source_district'] == district]\n","    candidates  = filter_candidates_by_ellipse_buffer(district_df, origin, destination, buffer_r)\n","    n_cands     = len(candidates)\n","\n","    # 각 알고리즘 실행 + 평가\n","    bf_score = None\n","    od_algo_results = {}\n","\n","    for algo_name, algo_fn in ALGORITHMS:\n","        selected, elapsed_ms = algo_fn(candidates, origin, destination)\n","\n","        if len(selected) == 0:\n","            print(f\"{district:<10} {algo_name:<12} {n_cands:<6} 선정 실패\")\n","            continue\n","\n","        metrics = evaluate_path(selected, origin, destination)\n","        if metrics is None:\n","            continue\n","\n","        od_algo_results[algo_name] = {\n","            'elapsed_ms': elapsed_ms,\n","            'metrics':    metrics,\n","            'selected':   selected,\n","        }\n","\n","        # BruteForce Score를 정답률 기준으로 보관\n","        if algo_name == 'BruteForce':\n","            bf_score = metrics['score']\n","\n","        # 시각화용 저장\n","        selections[(district, algo_name)] = {\n","            'selected':    selected,\n","            'visit_order': metrics['visit_order'],\n","            'origin':      origin,\n","            'destination': destination,\n","        }\n","\n","    # 결과 출력 및 DataFrame 행 생성\n","    for algo_name, _ in ALGORITHMS:\n","        r = od_algo_results.get(algo_name)\n","        if r is None:\n","            continue\n","        m = r['metrics']\n","\n","        # 정답률 계산 (BF Score 대비)\n","        if bf_score is not None and bf_score != 0:\n","            accuracy_pct = m['score'] / bf_score * 100\n","        else:\n","            accuracy_pct = None\n","\n","        results.append({\n","            'district':     district,\n","            'algorithm':    algo_name,\n","            'n_candidates': n_cands,\n","            'elapsed_ms':   round(r['elapsed_ms'], 3),\n","            'score':        round(m['score'], 3),\n","            'accuracy_pct': round(accuracy_pct, 2) if accuracy_pct is not None else None,\n","            'detour_km':    round(m['total_detour_km'], 3),\n","            'mpd_km':       round(m['mpd_km'], 3),\n","            'total_S':      round(m['total_S'], 3),\n","            'visit_order':  '|'.join(m['visit_order']),\n","        })\n","\n","        print(f\"{district:<10} {algo_name:<12} {n_cands:<6} {r['elapsed_ms']:>8.2f}  \"\n","              f\"{m['score']:>6.2f}  {m['total_detour_km']:>8.3f}    {m['mpd_km']:>6.3f}\")\n","    print()  # 군구 간 공백\n","\n","# DataFrame 정리 및 CSV 저장\n","results_df = pd.DataFrame(results)\n","output_csv = 'algorithm_test_results_v1.csv'\n","results_df.to_csv(output_csv, index=False, encoding='utf-8-sig')\n","print(f\"결과 CSV 저장: {output_csv} ({len(results_df)}행)\")\n","\n","# 알고리즘별 평균 (검증 PDF 7-1절 동일 포맷)\n","print(\"\\n[알고리즘별 평균 성능]\")\n","algo_summary = results_df.groupby('algorithm').agg(\n","    avg_score        = ('score',         'mean'),\n","    avg_accuracy_pct = ('accuracy_pct',  'mean'),\n","    avg_elapsed_ms   = ('elapsed_ms',    'mean'),\n","    avg_detour_km    = ('detour_km',     'mean'),\n","    avg_mpd_km       = ('mpd_km',        'mean'),\n",").round(3)\n","print(algo_summary.to_string())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"8-9fvMBzg3zC","executionInfo":{"status":"ok","timestamp":1779511317187,"user_tz":-540,"elapsed":7585,"user":{"displayName":"Yeonyeong Kim","userId":"11152061912583609011"}},"outputId":"0e1c4549-2509-4b91-b323-49d685d5bbf1"},"execution_count":11,"outputs":[{"output_type":"stream","name":"stdout","text":["군구         알고리즘         후보     시간(ms)     Score    우회(km)     MPD(km) \n","------------------------------------------------------------------------------\n","ganghwa    Greedy       27         6.58 