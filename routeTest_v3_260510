 the last promise value to make it available to the next\n","    // step of the generator.\n","    outputElement.lastPromiseValue = value;\n","    return next.value.response;\n","  });\n","}\n","\n","/**\n"," * Generator function which is called between each async step of the upload\n"," * process.\n"," * @param {string} inputId Element ID of the input file picker element.\n"," * @param {string} outputId Element ID of the output display.\n"," * @return {!Iterable<!Object>} Iterable of next steps.\n"," */\n","function* uploadFilesStep(inputId, outputId) {\n","  const inputElement = document.getElementById(inputId);\n","  inputElement.disabled = false;\n","\n","  const outputElement = document.getElementById(outputId);\n","  outputElement.innerHTML = '';\n","\n","  const pickedPromise = new Promise((resolve) => {\n","    inputElement.addEventListener('change', (e) => {\n","      resolve(e.target.files);\n","    });\n","  });\n","\n","  const cancel = document.createElement('button');\n","  inputElement.parentElement.appendChild(cancel);\n","  cancel.textContent = 'Cancel upload';\n","  const cancelPromise = new Promise((resolve) => {\n","    cancel.onclick = () => {\n","      resolve(null);\n","    };\n","  });\n","\n","  // Wait for the user to pick the files.\n","  const files = yield {\n","    promise: Promise.race([pickedPromise, cancelPromise]),\n","    response: {\n","      action: 'starting',\n","    }\n","  };\n","\n","  cancel.remove();\n","\n","  // Disable the input element since further picks are not allowed.\n","  inputElement.disabled = true;\n","\n","  if (!files) {\n","    return {\n","      response: {\n","        action: 'complete',\n","      }\n","    };\n","  }\n","\n","  for (const file of files) {\n","    const li = document.createElement('li');\n","    li.append(span(file.name, {fontWeight: 'bold'}));\n","    li.append(span(\n","        `(${file.type || 'n/a'}) - ${file.size} bytes, ` +\n","        `last modified: ${\n","            file.lastModifiedDate ? file.lastModifiedDate.toLocaleDateString() :\n","                                    'n/a'} - `));\n","    const percent = span('0% done');\n","    li.appendChild(percent);\n","\n","    outputElement.appendChild(li);\n","\n","    const fileDataPromise = new Promise((resolve) => {\n","      const reader = new FileReader();\n","      reader.onload = (e) => {\n","        resolve(e.target.result);\n","      };\n","      reader.readAsArrayBuffer(file);\n","    });\n","    // Wait for the data to be ready.\n","    let fileData = yield {\n","      promise: fileDataPromise,\n","      response: {\n","        action: 'continue',\n","      }\n","    };\n","\n","    // Use a chunked sending to avoid message size limits. See b/62115660.\n","    let position = 0;\n","    do {\n","      const length = Math.min(fileData.byteLength - position, MAX_PAYLOAD_SIZE);\n","      const chunk = new Uint8Array(fileData, position, length);\n","      position += length;\n","\n","      const base64 = btoa(String.fromCharCode.apply(null, chunk));\n","      yield {\n","        response: {\n","          action: 'append',\n","          file: file.name,\n","          data: base64,\n","        },\n","      };\n","\n","      let percentDone = fileData.byteLength === 0 ?\n","          100 :\n","          Math.round((position / fileData.byteLength) * 100);\n","      percent.textContent = `${percentDone}% done`;\n","\n","    } while (position < fileData.byteLength);\n","  }\n","\n","  // All done.\n","  yield {\n","    response: {\n","      action: 'complete',\n","    }\n","  };\n","}\n","\n","scope.google = scope.google || {};\n","scope.google.colab = scope.google.colab || {};\n","scope.google.colab._files = {\n","  _uploadFiles,\n","  _uploadFilesContinue,\n","};\n","})(self);\n","</script> "]},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Saving hotspots_CCTV_20260510.csv to hotspots_CCTV_20260510.csv\n","\n","총 핫스팟 수: 1,535곳\n","필드 수:       15개\n","\n","샘플 (3행):\n","           hotspot_id source_district  latitude  longitude  cctv_count install_years\n","bupyeong_wydj5j5q_001        bupyeong 37.469929 126.698868           1        [2009]\n","bupyeong_wydj5j88_001        bupyeong 37.471638 126.695032           1        [2007]\n","bupyeong_wydj5jbz_001        bupyeong 37.474223 126.695373           1        [2008]\n"]}]},{"cell_type":"code","source":["# ============================================================\n","# 셀 4: 군구별 데이터 비대칭성 실데이터 검증\n","# ------------------------------------------------------------\n","# 핸드오프 v1.1 4절의 군구별 특성을 통합 데이터에서 재확인\n","# ============================================================\n","\n","summary = hotspots.groupby('source_district').agg(\n","    hotspot_count=('hotspot_id', 'count'),\n","    cctv_sum=('cctv_count', 'sum'),\n","    cctv_mean=('cctv_count', 'mean'),\n","    cctv_max=('cctv_count', 'max'),\n",").round(2)\n","\n","# 다중 카메라(cctv_count >= 2) 비율\n","multi = (hotspots[hotspots['cctv_count'] >= 2]\n","         .groupby('source_district').size() / hotspots.groupby('source_district').size())\n","summary['multi_cam_pct'] = (multi * 100).round(1).fillna(0)\n","\n","# install_years 보유 비율\n","iy = (hotspots[hotspots['install_years'].notna()]\n","      .groupby('source_district').size() / hotspots.groupby('source_district').size())\n","summary['install_yr_pct'] = (iy * 100).round(1).fillna(0)\n","\n","# relocation_history 보유 건수\n","reloc = hotspots[hotspots['relocation_history'].notna()].groupby('source_district').size()\n","summary['reloc_count'] = reloc.reindex(summary.index).fillna(0).astype(int)\n","\n","print(\"군구별 데이터 요약:\")\n","print(summary.to_string())\n","print(f\"\\n전체 핫스팟: {len(hotspots):,}곳\")\n","print(f\"전체 카메라: {hotspots['cctv_count'].sum():,}대\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"W0iwc3playL6","executionInfo":{"status":"ok","timestamp":1778559691231,"user_tz":-540,"elapsed":120,"user":{"displayName":"Yeonyeong Kim","userId":"11152061912583609011"}},"outputId":"e79e099b-2625-445c-b42f-3d958b447339"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["군구별 데이터 요약:\n","                 hotspot_count  cctv_sum  cctv_mean  cctv_max  multi_cam_pct  install_yr_pct  reloc_count\n","source_district                                                                                          \n","bupyeong                    42        44       1.05         3            2.4           100.0           37\n","donggu                      48        49       1.02         2            2.1             0.0            4\n","ganghwa                     86        86       1.00         1            0.0             0.0            0\n","gyeyang                    292       398       1.36         4           28.8           100.0            0\n","junggu                      74        75       1.01         2            1.4           100.0            0\n","michuhol                   230       232       1.01         2            0.9             0.0            0\n","namdong                    155       163       1.05         2            5.2           100.0            0\n","seogu                      379       398       1.05         3            4.2             0.0            0\n","yeonsu                     229       393       1.72         4           60.3           100.0            0\n","\n","전체 핫스팟: 1,535곳\n","전체 카메라: 1,838대\n"]}]},{"cell_type":"code","source":["# ============================================================\n","# 셀 5: 거리·buffer 유틸리티 및 neighbor_200m 사전 계산\n","# ------------------------------------------------------------\n","# DETOUR_RATIO: 한국 도시 도보 환경 평균 보정계수\n","# neighbor_200m: S_i 공식(D2-2)의 입력값, BallTree로 고속 계산\n","# ============================================================\n","\n","DETOUR_RATIO    = 1.3\n","EARTH_RADIUS_KM = 6371.0\n","\n","\n","def walking_distance_km(p_a, p_b):\n","    \"\"\"추정 도보 거리 (km) = Haversine 직선거리 × 보정계수\"\"\"\n","    return hs.haversine(p_a, p_b, unit=hs.Unit.KILOMETERS) * DETOUR_RATIO\n","\n","\n","def detour_distance_km(origin, hotspot, destination):\n","    \"\"\"핫스팟 단독 경유 시 우회 거리 (km)\n","\n","    D_i = dist(O, h) + dist(h, D) - dist(O, D)\n","    부동소수 오차로 음수가 나오면 0으로 보정\n","    \"\"\"\n","    d_oh = walking_distance_km(origin, hotspot)\n","    d_hd = walking_distance_km(hotspot, destination)\n","    d_od = walking_distance_km(origin, destination)\n","    return max(d_oh + d_hd - d_od, 0.0)\n","\n","\n","def filter_candidates_by_ellipse_buffer(df, origin, destination, buffer_r_km):\n","    \"\"\"타원/회랑 buffer 필터링 (핸드오프 D10)\n","\n","    조건: dist(O,h) + dist(h,D) - dist(O,D) < buffer_r_km × 1.5\n","    \"\"\"\n","    d_od = walking_distance_km(origin, destination)\n","    threshold = buffer_r_km * 1.5\n","\n","    coords = df[['latitude', 'longitude']].values\n","    d_oh = np.array([walking_distance_km(origin,      tuple(c)) for c in coords])\n","    d_hd = np.array([walking_distance_km(tuple(c),    destination) for c in coords])\n","\n","    mask = (d_oh + d_hd - d_od) < threshold\n","    return df[mask].copy()\n","\n","\n","def get_buffer_radius(district):\n","    \"\"\"군구별 buffer 반경 (km) — 핸드오프 D4\n","\n","    강화군: 2.5km / 그 외: 1.5km\n","    \"\"\"\n","    return 2.5 if district == 'ganghwa' else 1.5\n","\n","\n","# neighbor_200m 사전 계산 (BallTree 기반 O(n log n))\n","print(\"neighbor_200m 사전 계산 시작...\")\n","t0 = time.time()\n","\n","coords_rad = np.radians(hotspots[['latitude', 'longitude']].values)\n","tree = BallTree(coords_rad, metric='haversine')\n","radius_rad = 0.2 / EARTH_RADIUS_KM   # 200m를 라디안으로 변환\n","\n","# query_radius는 자기 자신 포함 카운트 반환 → -1\n","counts = tree.query_radius(coords_rad, r=radius_rad, count_only=True)\n","hotspots['neighbor_200m'] = counts - 1\n","\n","print(f\"완료. 소요 시간: {time.time() - t0:.2f}초\")\n","print(f\"\\nneighbor_200m 통계:\")\n","print(hotspots['neighbor_200m'].describe().round(2))\n","\n","n_with_neighbor = (hotspots['neighbor_200m'] > 0).sum()\n","print(f\"\\n200m 내 이웃 보유 핫스팟: {n_with_neighbor:,}곳\"\n","      f\" ({n_with_neighbor / len(hotspots) * 100:.1f}%)\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"SHjmIp3iazqS","executionInfo":{"status":"ok","timestamp":1779511276849,"user_tz":-540,"elapsed":33,"user":{"displayName":"Yeonyeong Kim","userId":"11152061912583609011"}},"outputId":"ceaa279f-b422-471f-a7c2-20a30e34b19c"},"execution_count":6,"outputs":[{"output_type":"stream","name":"stdout","text":["neighbor_200m 사전 계산 시작...\n","완료. 소요 시간: 0.02초\n","\n","neighbor_200m 통계:\n","count    1535.00\n","mean        3.16\n","std         3.15\n","min         0.00\n","25%         1.00\n","50%         2.00\n","75%         5.00\n","max        17.00\n","Name: neighbor_200m, dtype: float64\n","\n","200m 내 이웃 보유 핫스팟: 1,178곳 (76.7%)\n"]}]},{"cell_type":"code","source":["# ============================================================\n","# 셀 6: S_i 계산 (D2-2 공식)\n","# ------------------------------------------------------------\n","# S_i = cctv_count + 0.5 × neighbor_200m\n","# 1차 정규화 미적용 (핸드오프 D7)\n","# ============================================================\n","\n","hotspots['S_i'] = hotspots['cctv_count'] + 0.5 * hotspots['neighbor_200m']\n","\n","print(\"S_i 전체 분포:\")\n","print(hotspots['S_i'].describe().round(2))\n","\n","print(\"\\n군구별 S_i 통계 (평균 / 최대 / 표준편차):\")\n","print(hotspots.groupby('source_district')['S_i']\n","      .agg(['mean', 'max', 'std']).round(2).to_string())\n","\n","print(f\"\\nS_i 상위 10곳:\")\n","top10 = hotspots.nlargest(10, 'S_i')[\n","    ['hotspot_id', 'source_district', 'dong', 'cctv_count', 'neighbor_200m', 'S_i']\n","]\n","print(top10.to_string(index=False))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"RpiRDw8da5lK","executionInfo":{"status":"ok","timestamp":1779511280447,"user_tz":-540,"elapsed":33,"user":{"displayName":"Yeonyeong Kim","userId":"11152061912583609011"}},"outputId":"c3a41ba6-70dd-4bff-9388-ed4ff338acec"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["S_i 전체 분포:\n","count    1535.00\n","mean        2.78\n","std         1.75\n","min         1.00\n","25%         1.50\n","50%         2.50\n","75%         3.50\n","max        11.00\n","Name: S_i, dtype: float64\n","\n","군구별 S_i 통계 (평균 / 최대 / 표준편차):\n","                 mean   max   std\n","source_district                  \n","bupyeong         1.25   3.5  0.51\n","donggu           1.88   3.5  0.65\n","ganghwa          1.07   2.0  0.21\n","gyeyang          3.51   8.5  1.79\n","junggu           1.94   3.5  0.85\n","michuhol         2.11   4.0  0.80\n","namdong          1.70   3.5  0.69\n","seogu            2.65   7.0  1.32\n","yeonsu           4.86  11.0  2.04\n","\n","S_i 상위 10곳:\n","          hotspot_id source_district dong  cctv_count  neighbor_200m  S_i\n"," yeonsu_wydhfms1_001          yeonsu  청학동           3             16 11.0\n"," yeonsu_wydhfmsf_001          yeonsu  청학동           1             17  9.5\n"," yeonsu_wydhfmt1_001          yeonsu  청학동           1             17  9.5\n"," yeonsu_wydhftjr_001          yeonsu  연수동           2             15  9.5\n"," yeonsu_wydhfms7_001          yeonsu  청학동           1             16  9.0\n"," yeonsu_wydhfmt8_001          yeonsu  청학동           3             12  9.0\n"," yeonsu_wydhfmu0_001          yeonsu  청학동           3             12  9.0\n","gyeyang_wydjsmxf_001         gyeyang  동양동           3             11  8.5\n"," yeonsu_wydhfmcd_001          yeonsu  청학동           3             11  8.5\n"," yeonsu_wydhfmuc_001          yeonsu  청학동           3             11  8.5\n"]}]},{"cell_type":"code","source":["# ============================================================\n","# 셀 7: 경로 추천 알고리즘 3종 구현\n","# ------------------------------------------------------------\n","# 가중치: α=0.5, β=0.5 (핸드오프 D6)\n","# K=3 경유, 후보 부족 시 K=2 fallback (핸드오프 D5)\n","# Brute Force는 S_i 상위 N=15 후보 풀로 제한 (핸드오프 D9)\n","# Greedy도 동일 후보 풀 사용 → 비교 공정성 확보\n","# Clustering은 buffer 전체 후보 사용 (군집 의미 보존)\n","# ============================================================\n","\n","ALPHA     = 0.5\n","BETA      = 0.5\n","K         = 3\n","BF_TOP_N  = 15\n","\n","\n","# ----- 공통 평가 함수 -----\n","def evaluate_path(selected_df, origin, destination):\n","    \"\"\"선택된 K개 핫스팟의 최적 방문 순서를 찾고 경로 메트릭 산출\n","\n","    K=3 기준 순열 6개를 모두 평가하여 총 거리 최소 순서 선택.\n","    이는 검증 PDF의 \"Google Maps SDK 경유지 최적화\"를 모사한다.\n","\n","    Returns:\n","        dict | None\n","    \"\"\"\n","    if len(selected_df) == 0:\n","        return None\n","\n","    coords = {row['hotspot_id']: (row['latitude'], row['longitude'])\n","              for _, row in selected_df.iterrows()}\n","    s_dict = {row['hotspot_id']: row['S_i'] for _, row in selected_df.iterrows()}\n","    direct_od = walking_distance_km(origin, destination)\n","\n","    best = {'total_path': float('inf'), 'order': None}\n","    for perm in itertools.permutations(selected_df['hotspot_id'].tolist()):\n","        path_pts = [origin] + [coords[hid] for hid in perm] + [destination]\n","        total = sum(walking_distance_km(path_pts[i], path_pts[i + 1])\n","                    for i in range(len(path_pts) - 1))\n","        if total < best['total_path']:\n","            best = {'total_path': total, 'order': perm}\n","\n","    total_detour = max(best['total_path'] - direct_od, 0.0)\n","    total_si     = sum(s_dict[hid] for hid in best['order'])\n","    score        = ALPHA * total_si - BETA * total_detour\n","\n","    # MPD: 선택 핫스팟 간 평균 거리\n","    hids = list(best['order'])\n","    if len(hids) >= 2:\n","        pairs = list(itertools.combinations(hids, 2))\n","        mpd = float(np.mean([walking_distance_km(coords[a], coords[b]) for a, b in pairs]))\n","    else:\n","        mpd = 0.0\n","\n","    return {\n","        'visit_order':     hids,\n","        'total_S':         total_si,\n","        'total_detour_km': total_detour,\n","        'total_path_km':   best['total_path'],\n","        'score':           score,\n","        'mpd_km':          mpd,\n","    }\n","\n","\n","# ----- 후보별 Score_i 계산 (Greedy·Clustering에서 사용) -----\n","def compute_scores(df, origin, destination):\n","    \"\"\"각 후보 핫스팟의 단일 점수 Score_i = α·S_i - β·D_i\"\"\"\n","    out = df.copy()\n","    out['D_i'] = out.apply(\n","        lambda r: detour_distance_km(origin, (r['latitude'], r['longitude']), destination),\n","        axis=1\n","    )\n","    out['Score_i'] = ALPHA * out['S_i'] - BETA * out['D_i']\n","    return out\n","\n","\n","# ----- Greedy Selection -----\n","def algorithm_greedy(candidates_df, origin, destination, k=K):\n","    \"\"\"S_i 상위 N개 후보 풀에서 Score_i 상위 K개 단순 선택\"\"\"\n","    t0 = time.time()\n","\n","    n = len(candidates_df)\n","    if n == 0:\n","        return pd.DataFrame(), (time.time() - t0) * 1000\n","    k_eff = min(k, n)\n","\n","    pool   = candidates_df.nlargest(min(BF_TOP_N, n), 'S_i')\n","    scored = compute_scores(pool, origin, destination)\n","    selected = scored.nlargest(k_eff, 'Score_i')\n","\n","    return selected, (time.time() - t0) * 1000\n","\n","\n","# ----- Brute Force -----\n","def algorithm_brute_force(candidates_df, origin, destination, k=K):\n","    \"\"\"S_i 상위 N개 후보 풀에서 모든 K개 조합·방문 순서 평가 → 최고 점수\"\"\"\n","    t0 = time.time()\n","\n","    n = len(candidates_df)\n","    if n == 0:\n","        return pd.DataFrame(), (time.time() - t0) * 1000\n","    k_eff = min(k, n)\n","\n","    pool     = candidates_df.nlargest(min(BF_TOP_N, n), 'S_i')\n","    pool_ids = pool['hotspot_id'].tolist()\n","\n","    best_score = -float('inf')\n","    best_ids   = None\n","    for combo in itertools.combinations(pool_ids, k_eff):\n","        combo_df = pool[pool['hotspot_id'].isin(combo)]\n","        result   = evaluate_path(combo_df, origin, destination)\n","        if result and result['score'] > best_score:\n","            best_score = result['score']\n","            best_ids   = combo\n","\n","    selected = pool[pool['hotspot_id'].isin(best_ids)].copy() if best_ids else pd.DataFrame()\n","    return selected, (time.time() - t0) * 1000\n","\n","\n","# ----- Clustering + Greedy -----\n","def algorithm_clustering(candidates_df, origin, destination, k=K):\n","    \"\"\"buffer 전체 후보를 K-means(K=3)로 군집화 후 군집별 Score_i 최고 1개씩\"\"\"\n","    t0 = time.time()\n","\n","    n = len(candidates_df)\n","    if n == 0:\n","        return pd.DataFrame(), (time.time() - t0) * 1000\n","    if n <= k:\n","        # 후보 수 ≤ K이면 군집화 의미 없음 → 전체 선택\n","        return candidates_df.copy(), (time.time() - t0) * 1000\n","\n","    coords   = candidates_df[['latitude', 'longitude']].values\n","    kmeans   = KMeans(n_clusters=k, n_init=10, random_state=42)\n","    clusters = kmeans.fit_predict(coords)\n","\n","    df = candidates_df.copy()\n","    df['cluster'] = clusters\n","    df = compute_scores(df, origin, destination)\n","\n","    selected = df.loc[df.groupby('cluster')['Score_i'].idxmax()].copy()\n","    return selected, (time.time() - t0) * 1000\n","\n","\n","# ----- 동작 확인 (임의 OD 1쌍) -----\n","print(\"알고리즘 함수 정의 완료. 임의 OD로 동작 확인:\")\n","\n","# 미추홀구청 → 인하대 인근\n","test_origin = (37.46347, 126.65029)\n","test_dest   = (37.4499,  126.6571)\n","test_buffer = 1.5\n","\n","# 미추홀구 핫스팟에서 후보 추출\n","test_df = hotspots[hotspots['source_district'] == 'michuhol']\n","cands   = filter_candidates_by_ellipse_buffer(test_df, test_origin, test_dest, test_buffer)\n","print(f\"\\n  미추홀구 buffer 후보: {len(cands)}곳\")\n","\n","for algo_name, algo_fn in [('Greedy',     algorithm_greedy),\n","                            ('BruteForce', algorithm_brute_force),\n","                            ('Clustering', algorithm_clustering)]:\n","    sel, elapsed = algo_fn(cands, test_origin, test_dest)\n","    if len(sel) > 0:\n","        result = evaluate_path(sel, test_origin, test_dest)\n","        print(f\"  {algo_name:11s}: {elapsed:7.2f}ms / \"\n","              f\"Score {result['score']:6.2f} / \"\n","              f\"우회 {result['total_detour_km']:.3f}km / \"\n","              f\"MPD {result['mpd_km']:.3f}km\")\n","    else:\n","        print(f\"  {algo_name:11s}: 선정 결과 없음\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"-Df4dUcRa8ZZ","executionInfo":{"status":"ok","timestamp":1779511285310,"user_tz":-540,"elapsed":1990,"user":{"displayName":"Yeonyeong Kim","userId":"11152061912583609011"}},"outputId":"c7764fc6-e2ad-4ab2-c217-1af38093a947"},"execution_count":8,"outputs":[{"output_type":"stream","name":"stdout","text":["알고리즘 함수 정의 완료. 임의 OD로 동작 확인:\n","\n","  미추홀구 buffer 후보: 87곳\n","  Greedy     :    6.67ms / Score   3.28 / 우회 3.438km / MPD 1.595km\n","  BruteForce :  603.00ms / Score   4.18 / 우회 2.141km / MPD 0.130km\n","  Clustering :   88.60ms / Score   3.40 / 우회 3.708km / MPD 2.297km\n"]}]},{"cell_type":"code","source":["# ============================================================\n","# 셀 7.5: OD 9쌍 좌표 변환 및 검증\n","# ------------------------------------------------------------\n","# 1. Google Geocoding으로 군청·구청·도착지 좌표 변환\n","# 2. 직선거리·buffer 내 후보 수 확인\n","# 3. 기준(2.5~3km) 충족 여부 검증\n","# ============================================================\n","\n","!pip install googlemaps --quiet\n","import googlemaps\n","\n","# Google Maps API Key (이전 셀에서 등록한 보안 비밀)\n","GMAPS_API_KEY = userdata.get('GOOGLE_MAPS_API_KEY')\n","gmaps = googlemaps.Client(key=GMAPS_API_KEY)\n","\n","\n","def geocode_one(address):\n","    \"\"\"주소 → (lat, lng) 변환. 실패 시 None\"\"\"\n","    try:\n","        result = gmaps.geocode(address, region='kr', language='ko')\n","        if result:\n","            loc = result[0]['geometry']['location']\n","            return (loc['lat'], loc['lng'])\n","    except Exception as e:\n","        print(f\"  Geocoding 실패: {address} ({e})\")\n","    return None\n","\n","\n","# 9개 OD 쌍 정의 (Origin 주소, Destination 주소)\n","OD_CANDIDATES = [\n","    # (군구코드,    Origin 주소,                          Destination 주소)\n","    ('ganghwa',    '인천 강화군 강화군청',                '인천 강화군 갑곶돈대'),\n","    ('junggu',     '인천 중구 신포로27번길 80',            '인천 중구 월미공원'),\n","    ('donggu',     '인천 동구 우각로 75',                  '인천 동구 송림공원'),\n","    ('michuhol',   '인천 미추홀구 인주대로 530',           '인천 미추홀구 문학경기장'),\n","    ('seogu',      '인천 서구청',                          '인천 서구 인천아시아드주경기장'),\n","    ('yeonsu',     '인천 연수구청',                        '인천 연수구 청량산'),\n","    ('namdong',    '인천 남동구청',                        '인천 남동구 인천종합문화예술회관'),\n","    ('bupyeong',   '인천 부평구청',                        '인천 부평구 백운공원'),\n","    ('gyeyang',    '인천 계양구청',                        '인천 계양구 계양체육공원'),\n","]\n","\n","\n","# 좌표 변환 + 거리 검증 + buffer 후보 수 확인\n","print(\"OD 9쌍 검증 시작\\n\")\n","print(f\"{'군구':<10} {'직선거리':<10} {'buffer':<8} {'후보수':<8} {'기준':<10}\")\n","print(\"-\" * 60)\n","\n","od_results = []\n","for district, origin_addr, dest_addr in OD_CANDIDATES:\n","    origin = geocode_one(origin_addr)\n","    dest = geocode_one(dest_addr)\n","\n","    if not origin or not dest:\n","        print(f\"{district:<10} 좌표 변환 실패\")\n","        continue\n","\n","    # 직선거리 (Haversine, 보정 없는 raw 거리)\n","    direct_km = hs.haversine(origin, dest, unit=hs.Unit.KILOMETERS)\n","\n","    # buffer 후보 수 확인\n","    buffer_r = get_buffer_radius(district)\n","    district_df = hotspots[hotspots['source_district'] == district]\n","    cands = filter_candidates_by_ellipse_buffer(district_df, origin, dest, buffer_r)\n","\n","    # 기준 충족 여부 (2.5~3km)\n","    if 2.5 <= direct_km <= 3.0:\n","        status = \"OK\"\n","    elif direct_km < 2.5:\n","        status = \"짧음\"\n","    else:\n","        status = \"긺\"\n","\n","    print(f\"{district:<10} {direct_km:>5.2f} km    {buffer_r}km   {len(cands):>4}곳     {status}\")\n","\n","    od_results.append({\n","        'district':    district,\n","        'origin_addr': origin_addr,\n","        'dest_addr':   dest_addr,\n","        'origin':      origin,\n","        'destination': dest,\n","        'direct_km':   direct_km,\n","        'buffer_r_km': buffer_r,\n","        'n_candidates': len(cands),\n","        'status':      status,\n","    })\n","\n","print()\n","print(\