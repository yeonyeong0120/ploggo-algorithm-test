 기반이므로 시각화 비교 목적에 충분\n","# 셀 9에서 27회 호출 예정 (9 OD × 3 algorithm)\n","# ============================================================\n","\n","NAVER_ID = userdata.get('NAVER_MAPS_CLIENT_ID')\n","NAVER_SECRET = userdata.get('NAVER_MAPS_CLIENT_SECRET')\n","assert NAVER_ID and NAVER_SECRET, \"Naver Cloud 인증정보가 보안 비밀에 등록되어 있어야 한다\"\n","\n","NAVER_DIRECTIONS_URL = \"https://maps.apigw.ntruss.com/map-direction/v1/driving\"\n","\n","\n","def call_naver_directions(start_lat, start_lng, goal_lat, goal_lng, waypoints=None):\n","    \"\"\"Naver Directions 5 API 호출\n","\n","    경유지(waypoints)는 최대 5개까지 지원되며, 알고리즘이 선정한\n","    K=3 핫스팟 좌표를 그대로 전달하여 경로 polyline을 받는다.\n","\n","    Args:\n","        start_lat, start_lng: 출발지 위도/경도\n","        goal_lat, goal_lng:   도착지 위도/경도\n","        waypoints:            경유지 list of (lat, lng), 최대 5개\n","\n","    Returns:\n","        dict | None: {\n","            'distance_m':   int,\n","            'duration_min': int,\n","            'path':         list of [lng, lat],   # Naver는 lng, lat 순서\n","        }\n","    \"\"\"\n","    headers = {\n","        'X-NCP-APIGW-API-KEY-ID':  NAVER_ID,\n","        'X-NCP-APIGW-API-KEY':     NAVER_SECRET,\n","    }\n","    # Naver API는 좌표 순서가 'lng,lat'임에 주의\n","    params = {\n","        'start':  f'{start_lng},{start_lat}',\n","        'goal':   f'{goal_lng},{goal_lat}',\n","        'option': 'trafast',\n","    }\n","    if waypoints:\n","        params['waypoints'] = '|'.join(f'{lng},{lat}' for lat, lng in waypoints)\n","\n","    try:\n","        resp = requests.get(NAVER_DIRECTIONS_URL, headers=headers, params=params, timeout=10)\n","        body = resp.json()\n","    except Exception as e:\n","        print(f\"  호출 실패: {e}\")\n","        return None\n","\n","    if body.get('code') != 0:\n","        # code 1: 출발지/도착지 동일 / code 2: 경로 없음 등\n","        return None\n","\n","    route_data = body['route']['trafast'][0]\n","    summary = route_data['summary']\n","    return {\n","        'distance_m':   summary['distance'],\n","        'duration_min': summary['duration'] // 60000,\n","        'path':         route_data['path'],     # [[lng, lat], ...]\n","    }\n","\n","\n","# 동작 확인 (검증된 좌표)\n","print(\"Naver Directions 5 동작 확인:\")\n","result = call_naver_directions(\n","    start_lat=37.46347, start_lng=126.65029,    # 미추홀구청\n","    goal_lat=37.4499,   goal_lng=126.6571,      # 인하대 인근\n",")\n","if result:\n","    print(f\"  정상 동작\")\n","    print(f\"  거리: {result['distance_m']:,}m\")\n","    print(f\"  소요시간: {result['duration_min']}분\")\n","    print(f\"  polyline 좌표 수: {len(result['path'])}개\")\n","else:\n","    print(\"  호출 실패\")"],"metadata":{"id":"FwNVsANnWAm2","executionInfo":{"status":"error","timestamp":1779511199423,"user_tz":-540,"elapsed":1488,"user":{"displayName":"Yeonyeong Kim","userId":"11152061912583609011"}},"outputId":"ca3b488c-78d9-4a53-be12-20fc97f9cd4b","colab":{"base_uri":"https://localhost:8080/","height":391}},"execution_count":3,"outputs":[{"output_type":"error","ename":"KeyboardInterrupt","evalue":"","traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mKeyboardInterrupt\u001b[0m                         Traceback (most recent call last)","\u001b[0;32m/tmp/ipykernel_2435/2076175628.py\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0m\n\u001b[1;32m      9\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m     10\u001b[0m \u001b[0mNAVER_ID\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0muserdata\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mget\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m'NAVER_MAPS_CLIENT_ID'\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m---> 11\u001b[0;31m \u001b[0mNAVER_SECRET\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0muserdata\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mget\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m'NAVER_MAPS_CLIENT_SECRET'\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\