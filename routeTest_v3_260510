 '인천 서구 가좌역'),            # 변경\n","    ('yeonsu',     '인천 연수구청',                         '인천 연수구 청량산'),\n","    ('namdong',    '인천 남동구청',                         '인천 남동구 인천종합문화예술회관'),\n","    ('bupyeong',   '인천 부평구청',                         '인천 부평구 백운공원'),\n","    ('gyeyang',    '인천 계양구청',                         '인천 계양구 작전역'),          # 변경\n","]\n","\n","\n","print(\"OD 9쌍 재검증 (새 기준: 직선 1.54km 이상)\\n\")\n","print(f\"{'군구':<10} {'직선거리':<10} {'예상시간':<10} {'후보수':<8} {'판정':<10}\")\n","print(\"-\" * 60)\n","\n","od_final = []\n","for district, origin_addr, dest_addr in OD_CANDIDATES_V2:\n","    origin = geocode_one(origin_addr)\n","    dest = geocode_one(dest_addr)\n","\n","    if not origin or not dest:\n","        print(f\"{district:<10} 좌표 변환 실패: {dest_addr}\")\n","        continue\n","\n","    direct_km = hs.haversine(origin, dest, unit=hs.Unit.KILOMETERS)\n","    walk_min = int(direct_km * 1.3 / 4.0 * 60)   # 도보 4km/h 기준\n","\n","    buffer_r = get_buffer_radius(district)\n","    district_df = hotspots[hotspots['source_district'] == district]\n","    cands = filter_candidates_by_ellipse_buffer(district_df, origin, dest, buffer_r)\n","\n","    if direct_km >= 1.54 and len(cands) >= 5:\n","        status = \"OK\"\n","    elif direct_km < 1.54:\n","        status = \"짧음\"\n","    else:\n","        status = \"후보부족\"\n","\n","    print(f\"{district:<10} {direct_km:>5.2f} km    약 {walk_min:>2}분   {len(cands):>4}곳     {status}\")\n","\n","    od_final.append({\n","        'district':     district,\n","        'origin_addr':  origin_addr,\n","        'dest_addr':    dest_addr,\n","        'origin':       origin,\n","        'destination':  dest,\n","        'direct_km':    direct_km,\n","        'walk_min':     walk_min,\n","        'buffer_r_km':  buffer_r,\n","        'n_candidates': len(cands),\n","        'status':       status,\n","    })\n","\n","print()\n","all_ok = all(r['status'] == 'OK' for r in od_final)\n","if all_ok:\n","    print(\"9개 OD 모두 통과. 셀 8 진입 가능\")