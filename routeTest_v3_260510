    selected    = sel_data['selected']\n","    visit_order = sel_data['visit_order']\n","\n","    # 방문 순서대로 좌표 구성\n","    coords_dict = {row['hotspot_id']: (row['latitude'], row['longitude'])\n","                   for _, row in selected.iterrows()}\n","    waypoints = [coords_dict[hid] for hid in visit_order]\n","\n","    # 1회만 호출 (캐싱)\n","    path, real_distance = fetch_route_path(origin, destination, waypoints)\n","    is_real = path is not None\n","    if not is_real:\n","        # 폴백: 직선 path\n","        path = [origin] + waypoints + [destination]\n","\n","    # 지도 중심\n","    center_lat = (origin[0] + destination[0]) / 2\n","    center_lng = (origin[1] + destination[1]) / 2\n","    m = folium.Map(location=[center_lat, center_lng], zoom_start=14)\n","\n","    color = COLOR_MAP.get(algo_name, 'gray')\n","\n","    # 경로 polyline\n","    folium.PolyLine(\n","        path,\n","        color=color,\n","        weight=4,\n","        opacity=0.8,\n","        tooltip=f\"{algo_name} 경로 ({'Naver 실도로' if is_real else 'Haversine 직선'})\"\n","    ).add_to(m)\n","\n","    # Origin 마커\n","    folium.Marker(\n","        origin,\n","        popup=f\"<b>출발</b><br>{district}\",\n","        icon=folium.Icon(color='blue', icon='play', prefix='fa'),\n","    ).add_to(m)\n","\n","    # Destination 마커\n","    folium.Marker(\n","        destination,\n","        popup=\"<b>도착</b>\",\n","        icon=folium.Icon(color='red', icon='stop', prefix='fa'),\n","    ).add_to(m)\n","\n","    # K개 핫스팟 마커 (방문 순서 번호)\n","    for i, hid in enumerate(visit_order, 1):\n","        coord = coords_dict[hid]\n","        row   = selected[selected['hotspot_id'] == hid].iloc[0]\n","        popup_text = (\n","            f\"<b>경유지 {i}</b><br>\"\n","            f\"ID: {hid}<br>\"\n","            f\"S_i: {row['S_i']:.2f}<br>\"\n","            f\"cctv: {row['cctv_count']} / neighbor: {row['neighbor_200m']}<br>\"\n","            f\"동: {row['dong']}\"\n","        )\n","        folium.Marker(\n","            coord,\n","            popup=folium.Popup(popup_text, max_width=250),\n","            icon=folium.DivIcon(\n","                html=f'<div style=\"background:{color}; color:white; '\n","                     f'border-radius:50%; width:28px; height:28px; '\n","                     f'text-align:center; line-height:28px; font-weight:bold; '\n","                     f'border:2px solid white;\">{i}</div>'\n","            ),\n","        ).add_to(m)\n","\n","    # 폴백 안내 라벨\n","    if not is_real:\n","        folium.Marker(\n","            [center_lat, center_lng],\n","            icon=folium.DivIcon(\n","                html='<div style=\"background:#ffe; padding:4px 8px; '\n","                     'border:1px solid red; font-size:11px; border-radius:4px;\">'\n","                     '직선 폴백 (Naver API 호출 실패)</div>'\n","            ),\n","        ).add_to(m)\n","\n","    # 제목\n","    title_html = (\n","        f'<div style=\"position:fixed; top:10px; left:50px; z-index:9999; '\n","        f'background:white; padding:8px 12px; border:2px solid {color}; '\n","        f'border-radius:6px; font-size:14px; font-weight:bold;\">'\n","        f'{district} — {algo_name}</div>'\n","    )\n","    m.get_root().html.add_child(folium.Element(title_html))\n","\n","    return m, is_real\n","\n","\n","# 27개 지도 일괄 생성\n","print(\"folium 시각화 생성 시작 (총 27개)...\")\n","api_failures = []\n","\n","for (district, algo_name), sel_data in selections.items():\n","    m, is_real = create_map_for_od_algo(district, algo_name, sel_data)\n","    filename = f'viz/{district}_{algo_name}.html'\n","    m.save(filename)\n","    if not is_real:\n","        api_failures.append((district, algo_name))\n","\n","print(f\"\\n완료. 'viz/' 디렉토리에 27개 HTML 저장됨\")\n","print(f\"  Naver API 호출 성공: {27 - len(api_failures)}건\")\n","print(f\"  Naver API 호출 실패 (직선 폴백): {len(api_failures)}건\")\n","if api_failures:\n","    for d, a in api_failures:\n","        print(f\"    - {d} / {a}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/